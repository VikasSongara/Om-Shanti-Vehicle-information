# Admin credentials
# Local/dev defaults (used when SPRING_PROFILES_ACTIVE=dev):
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --------------------
# LOCAL (SQL Server) — spring.profiles.active=dev
# --------------------
# SPRING_PROFILES_ACTIVE=dev
# DB defaults are already in application-dev.properties:
#   jdbc:sqlserver://192.168.100.55:1440;databaseName=vs_Test;...
#   user=PTDev / password=PTDev
# Override if needed:
# SPRING_DATASOURCE_URL=jdbc:sqlserver://192.168.100.55:1440;databaseName=vs_Test;encrypt=true;trustServerCertificate=true
# DB_USER=PTDev
# DB_PASSWORD=PTDev

# --------------------
# PRODUCTION / RENDER (PostgreSQL Supabase) — spring.profiles.active=prod
# --------------------
# SPRING_PROFILES_ACTIVE=prod
# COOKIE_SECURE=true
# REQUIRED — must set these on Render (no defaults in prod):
# ADMIN_USERNAME=your-admin-username
# ADMIN_PASSWORD=your-strong-password
# Use Session pooler (IPv4), not direct db.* host:
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.tqdduurvsqqnfqqdgfbx
# DB_PASSWORD=your-supabase-db-password
