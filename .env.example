# Profiles are set at runtime, not via this file:
#   java -jar vehicle-information-system.jar --spring.profiles.active=dev
#   java -jar vehicle-information-system.jar --spring.profiles.active=prod
#
# Configuration lives in:
#   src/main/resources/application-dev.properties  (local SQL Server)
#   src/main/resources/application-prod.properties (production Supabase)
#
# Do not commit real production passwords to a public git repo.
# Edit application-prod.properties on the server or use a private repo.
